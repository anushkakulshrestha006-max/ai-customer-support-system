# ==============================================================================
# Streamlit Frontend Dockerfile — NovaStore AI Customer Support System
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Streamlit application and service formatters
COPY app/services/response_formatter.py ./app/services/response_formatter.py
COPY app/services/__init__.py ./app/services/__init__.py
COPY app/__init__.py ./app/__init__.py
COPY streamlit_app/ ./streamlit_app/

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8501}/_stcore/health || exit 1

CMD ["sh", "-c", "streamlit run streamlit_app/app.py --server.port=${PORT:-8501} --server.address=0.0.0.0"]
