# Streamlit Secrets Configuration Template
# ----------------------------------------
# For Streamlit Community Cloud:
# Paste these key-value pairs into App Settings > Secrets in the Streamlit Cloud dashboard.
#
# For local Streamlit secret testing:
# Copy this file to .streamlit/secrets.toml (this path is ignored by git).

# Full URL to your deployed FastAPI backend (no trailing slash)
BACKEND_URL = "https://your-backend-api.onrender.com"

# Admin API Key (Optional in Streamlit secrets):
# - If set here, the frontend automatically authorizes all users who click "Apply Change".
# - Recommended for public student portfolios: Leave empty or omit so that public visitors
#   cannot modify ticket statuses unless they enter the key on-demand in the UI.
ADMIN_API_KEY = ""
