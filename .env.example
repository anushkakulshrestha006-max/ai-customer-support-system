# ==============================================================================
# NovaStore AI Customer Support System - Environment Template (.env.example)
# Copy this file to '.env' for local development or set these variables
# directly in your cloud hosting provider's Environment / Secrets dashboard.
# ==============================================================================

# Application Environment: 'development' or 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
# Option A: Individual connection settings (recommended for local / managed MySQL)
# For production, use a dedicated restricted user rather than 'root'.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=support_user
MYSQL_PASSWORD=your_secure_db_password
MYSQL_DATABASE=ai_customer_support

# Option B: Single connection URI (common on cloud hosts like Railway, Render, Supabase)
# If set, DATABASE_URL overrides the individual MYSQL_* variables above.
# Example: mysql+pymysql://user:password@hostname:3306/dbname
DATABASE_URL=

# Database connection pool tuning (optional, defaults provided below)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Google Gemini / LLM Configuration
# ------------------------------------------------------------------------------
# Provide your Google Gemini API key from Google AI Studio.
# If omitted or invalid, the system automatically runs in local policy-grounded
# fallback mode (no external API calls or costs incurred).
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
# In cloud deployments, platforms like Render/Railway automatically inject 'PORT'.
# BACKEND_PORT defaults to PORT if present, otherwise 8001.
PORT=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# Public URL of the FastAPI backend used by the Streamlit frontend.
# Local development: http://127.0.0.1:8001
# Production: https://your-backend-service.onrender.com
BACKEND_URL=http://127.0.0.1:8001

# Allowed CORS Origins (comma-separated).
# In production, set to your deployed Streamlit frontend URL.
# Example: https://novastore-support.streamlit.app,http://localhost:8501
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ------------------------------------------------------------------------------
# Security & Administrative Protection
# ------------------------------------------------------------------------------
# Administrative secret key required to update ticket statuses in production.
# In production (ENVIRONMENT=production), ADMIN_API_KEY is strictly enforced.
# Missing or invalid keys lock down ticket modifications rather than bypassing auth.
# In local development without this key set, open demonstration access is permitted.
ADMIN_API_KEY=your_admin_secret_key_here
